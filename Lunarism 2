--// Logic Functions \\--
local function getClosestPlayerToCursor()
    local closest, shortestDistance = nil, math.huge
    local mousePos = UserInputService:GetMouseLocation()

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local screenPos, onScreen = Camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
                if onScreen then
                    local magnitude = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if magnitude < shortestDistance then
                        closest = player
                        shortestDistance = magnitude
                    end
                end
            end
        end
    end
    return closest
end

-- ESP Setup
local function updateESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char then
                local highlight = char:FindFirstChild("LunarismESP")
                if Features.ESP.Enabled then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "LunarismESP"
                        highlight.FillColor = Features.ESP.Color
                        highlight.OutlineColor = Color3.new(1, 1, 1)
                        highlight.FillTransparency = 0.5
                        highlight.Parent = char
                    end
                else
                    if highlight then highlight:Destroy() end
                end
            end
        end
    end
end

-- Main Loop (Camlock, Hitbox, AntiSlow)
RunService.RenderStepped:Connect(function()
    -- Camlock
    if Features.Camlock.Enabled and Features.Camlock.Target and Features.Camlock.Target.Character then
        local targetChar = Features.Camlock.Target.Character
        local aimPart = targetChar:FindFirstChild(Features.Camlock.AimPart)
        if aimPart then
            local predictedPos = aimPart.Position + (aimPart.AssemblyLinearVelocity * Features.Camlock.Prediction)
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, predictedPos)
        end
    end

    -- Hitbox Expander
    if Features.Hitbox.Enabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local root = player.Character.HumanoidRootPart
                root.Size = Vector3.new(Features.Hitbox.Size, Features.Hitbox.Size, Features.Hitbox.Size)
                root.Transparency = 0.6
                root.CanCollide = false
            end
        end
    end
    
    -- Anti-Slow & Movement
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        local hum = LocalPlayer.Character.Humanoid
        if Features.Movement.AntiSlow or Features.Movement.WalkSpeed > 16 then
            hum.WalkSpeed = Features.Movement.WalkSpeed
        end
        if Features.Movement.JumpPower > 50 then
            hum.JumpPower = Features.Movement.JumpPower
        end
    end

    -- Visuals
    Camera.FieldOfView = Features.Visuals.FOV
end)

Players.PlayerAdded:Connect(updateESP)
Players.PlayerRemoving:Connect(updateESP)

-- Keybinds
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Q and Features.Camlock.Enabled then
        Features.Camlock.Target = Features.Camlock.Target and nil or getClosestPlayerToCursor()
    end
end)

