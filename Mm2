local function UpdateESP()
    if not Config.ESP.Enabled then
        -- Clear all ESP
        for player, esp in pairs(ESPObjects) do
            for _, obj in pairs(esp) do
                if obj and obj:IsA("Instance") then
                    obj:Destroy()
                end
            end
        end
        table.clear(ESPObjects)
        return
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= Player and player.Character then
            local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
            if rootPart then
                local distance = (Player.Character.HumanoidRootPart.Position - rootPart.Position).Magnitude
                
                if distance <= Config.ESP.MaxDistance then
                    if not ESPObjects[player] then
                        CreateESP(player)
                    end
                    
                    local esp = ESPObjects[player]
                    
                    -- Update positions
                    if esp.Box then
                        esp.Box.CFrame = rootPart.CFrame
                        esp.Box.Adornee = rootPart
                    end
                    
                    if esp.Outline then
                        esp.Outline.CFrame = rootPart.CFrame
                        esp.Outline.Adornee = rootPart
                    end
                    
                    if esp.HealthBar and esp.HealthFill then
                        local humanoid = player.Character:FindFirstChild("Humanoid")
                        if humanoid then
                            local healthPercent = humanoid.Health / humanoid.MaxHealth
                            esp.HealthFill.Size = UDim2.new(1, 0, healthPercent, 0)
                            esp.HealthBar.Position = UDim2.new(0, rootPart.Position.X, 0, rootPart.Position.Y - 3)
                        end
                    end
                    
                    if esp.DistanceLabel then
                        esp.DistanceLabel.Adornee = rootPart
                        esp.DistanceLabel:FindFirstChildWhichIsA("TextLabel").Text = math.floor(distance) .. "m"
                    end
                    
                    if esp.NameTag then
                        esp.NameTag.Adornee = rootPart
                        esp.NameTag:FindFirstChildWhichIsA("TextLabel").Text = player.DisplayName
                    end
                else
                    -- Remove ESP if too far
                    if ESPObjects[player] then
                        for _, obj in pairs(ESPObjects[player]) do
                            if obj and obj:IsA("Instance") then
                                obj:Destroy()
                            end
                        end
                        ESPObjects[player] = nil
                    end
                end
            end
        end
    end
end

