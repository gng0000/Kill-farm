local function animationHook(track)
    if track and track.Animation then
        local animId = tostring(track.Animation.AnimationId or "")

        if Dex.Kyoto.Enabled and string.find(animId, Dex.Kyoto.AnimId, 1, true) then
            task.delay(Dex.Kyoto.Delay, function()
                if Dex.Kyoto.Enabled then executeKyoto() end
            end)
        end

        if Dex.Lethal.Enabled and string.find(animId, Dex.Lethal.AnimId, 1, true) then
            task.wait(1.7)
            if DexState.Root then DexState.Root.AssemblyLinearVelocity = Vector3.new(0, Dex.Lethal.Boost, 0) end
            executeLethalAim()
            if DexState.Char and DexState.Char:FindFirstChild("Communicate") then
                DexState.Char.Communicate:FireServer({Dash = Enum.KeyCode.W, Key = Enum.KeyCode.Q, Goal = "KeyPress"})
            end
        end

        if Dex.Mimic.TriggerId ~= "" and string.find(animId, Dex.Mimic.TriggerId, 1, true) and not Dex.Supa.DashPattern then
            task.spawn(executeMimicPlayback)
        end

        if (Dex.Supa.Floater or Dex.Supa.AimHead) and (string.find(animId, "10503381238", 1, true) or string.find(animId, "13379003796", 1, true)) then
            task.delay(Dex.Supa.Delay, function()
                if not Dex.Supa.FrogJump then
                    if not Dex.Supa.AimHead then
                        if Dex.Supa.Floater then triggerDownSupaSafely("Floater") end
                        return
                    end
                    triggerDownSupaSafely("AimHead")
                    return
                end
                triggerDownSupaSafely("Frog")
            end)
        end

        if Dex.Twisted.Enabled and string.find(animId, "13294471966", 1, true) then
            task.spawn(executeTwisted)
        end
    end
end

local function setupCharacter(character)
    for _, conn in pairs(DexState.Connections) do
        pcall(function() conn:Disconnect() end)
    end
    DexState.Connections = {}

    local hum = character:WaitForChild("Humanoid")
    local root = character:WaitForChild("HumanoidRootPart")

    DexState.Char = character
    DexState.Hum = hum
    DexState.Root = root

    local ok, res = pcall(function() return hum.AnimationPlayed:Connect(animationHook) end)
    if ok and res then table.insert(DexState.Connections, res) end

    local animator = hum:FindFirstChildOfClass("Animator")
    if animator then
        local ok2, res2 = pcall(function() return animator.AnimationPlayed:Connect(animationHook) end)
        if ok2 and res2 then table.insert(DexState.Connections, res2) end
    end
end

