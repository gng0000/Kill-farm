           (Config.GunESP.ShowKnives and obj.Name:match("Knife")) then
            if not GunESPObjects[obj] then
                local gunESP = Instance.new("BoxHandleAdornment")
                gunESP.Name = "GunESP"
                gunESP.Size = Vector3.new(2, 2, 2)
                gunESP.AlwaysOnTop = true
                gunESP.ZIndex = 10
                gunESP.Transparency = 0.3
                gunESP.Color = Color3.fromRGB(255, 255, 0)
                gunESP.Parent = Camera
                GunESPObjects[obj] = gunESP
            end
            
            local handle = obj:FindFirstChild("Handle") or obj:FindFirstChild("hitbox")
            if handle then
                local distance = (Player.Character.HumanoidRootPart.Position - handle.Position).Magnitude
                if distance <= Config.GunESP.MaxDistance then
                    GunESPObjects[obj].CFrame = handle.CFrame
