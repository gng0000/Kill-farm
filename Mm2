-- // Save/Load Config
local ConfigFolder = "MM2_Ultimate_Hub"
local ConfigFile = "Config.json"

local function SaveConfig()
    if not isfolder(ConfigFolder) then
        makefolder(ConfigFolder)
    end
    writefile(ConfigFolder .. "/" .. ConfigFile, game:GetService("HttpService"):JSONEncode(Config))
    print("✅ Config saved!")
end

local function LoadConfig()
    if isfolder(ConfigFolder) and isfile(ConfigFolder .. "/" .. ConfigFile) then
        local success, data = pcall(function()
            return game:GetService("HttpService"):JSONDecode(readfile(ConfigFolder .. "/" .. ConfigFile))
        end)
        if success then
            Config = data
            print("✅ Config loaded!")
        end
    end
end

-- // Utility Functions
local function GetNearestPlayer(maxDistance)
    local nearest = nil
    local nearestDistance = maxDistance or MAX_RANGE
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= Player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local distance = (Player.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
            if distance < nearestDistance then
                nearest = player
                nearestDistance = distance
            end
        end
    end
    
    return nearest, nearestDistance
end

local function GetNearestGun(maxDistance)
    local nearest = nil
    local nearestDistance = maxDistance or MAX_RANGE
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Tool") or obj.Name:match("Gun") or obj.Name:match("Knife") then
            local handle = obj:FindFirstChild("Handle") or obj:FindFirstChild("hitbox")
            if handle then
                local distance = (Player.Character.HumanoidRootPart.Position - handle.Position).Magnitude
                if distance < nearestDistance then
                    nearest = obj
                    nearestDistance = distance
                end
            end
        end
    end
    
    return nearest, nearestDistance
end

local function GetPlayerRole(player)
    -- Check for role indicators in MM2
    if not player.Character then return "Innocent" end
    
    local tools = player.Character:GetChildren()
    for _, tool in ipairs(tools) do
        if tool:IsA("Tool") then
            if tool.Name:match("Gun") or tool.Name:match("Luger") or tool.Name:match("Revolver") then
                return "Sheriff"
            elseif tool.Name:match("Knife") or tool.Name:match("Sword") then
                return "Murderer"
            end
        end
    end
    
    return "Innocent"
end

local function IsTeam(player)
    -- Simple team check (you can enhance this based on MM2's team system)
    return player.Team == Player.Team
end

