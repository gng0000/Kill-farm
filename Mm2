-- // Keybind System
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Config.Keybinds.Killaura then
        Config.Killaura.Enabled = not Config.Killaura.Enabled
        print("🔪 Killaura: " .. (Config.Killaura.Enabled and "Enabled" or "Disabled"))
    elseif input.KeyCode == Config.Keybinds.SilentAim then
        Config.SilentAim.Enabled = not Config.SilentAim.Enabled
        print("🎯 Silent Aim: " .. (Config.SilentAim.Enabled and "Enabled" or "Disabled"))
    elseif input.KeyCode == Config.Keybinds.ESP then
        Config.ESP.Enabled = not Config.ESP.Enabled
        print("👁️ ESP: " .. (Config.ESP.Enabled and "Enabled" or "Disabled"))
    elseif input.KeyCode == Config.Keybinds.Fly then
        Config.Movement.Fly = not Config.Movement.Fly
        print("🚀 Fly: " .. (Config.Movement.Fly and "Enabled" or "Disabled"))
    elseif input.KeyCode == Config.Keybinds.Speed then
        Config.Movement.Speed = not Config.Movement.Speed
        print("⚡ Speed: " .. (Config.Movement.Speed and "Enabled" or "Disabled"))
        ApplyMovement()
    end
end)

-- // Main Loop
RunService.Heartbeat:Connect(function()
    pcall(function()
        -- Update features
        RunKillaura()
        UpdateSilentAim()
