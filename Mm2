--// Helper Functions (Original Logic) \\--
local function getClosestPlayerToCursor()
    local closest, shortestDistance = nil, math.huge
    local mousePos = UserInputService:GetMouseLocation()

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local screenPos, onScreen = Camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
                if onScreen then
                    local magnitude = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if magnitude < shortestDistance then
                        closest = player
                        shortestDistance = magnitude
                    end
                end
            end
        end
    end
    return closest
end

local function updateESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char then
                local highlight = char:FindFirstChild("LunarismESP")
                if Features.ESP.Enabled then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "LunarismESP"
                        highlight.FillColor = Features.ESP.Color
                        highlight.OutlineColor = Color3.new(1, 1, 1)
                        highlight.FillTransparency = 0.5
                        highlight.Parent = char
                    end
                else
                    if highlight then highlight:Destroy() end
                end
            end
        end
    end
end

--// Dex Hub Helper Logic \\--
local function getClosestModelDex(aimHead)
    if DexState.Root then
        local closestTarget = nil
        local shortestDistance = 500

        for _, descendant in pairs(workspace:GetDescendants()) do
            if descendant:IsA("Model") and descendant ~= DexState.Char then
                local targetPart
                if not aimHead then
                    targetPart = descendant:FindFirstChild("HumanoidRootPart")
                else
                    local parts = {}
                    local head = descendant:FindFirstChild("Head")
                    local torso = descendant:FindFirstChild("Torso") or descendant:FindFirstChild("UpperTorso")
                    local hrp = descendant:FindFirstChild("HumanoidRootPart")

                    if head then table.insert(parts, head) end
                    if torso then table.insert(parts, torso) end
                    if hrp and #parts == 0 then table.insert(parts, hrp) end

                    targetPart = #parts > 0 and parts[math.random(1, #parts)] or nil
                end

                if targetPart and targetPart:IsA("BasePart") then
                    local hum = descendant:FindFirstChildOfClass("Humanoid")
                    if not hum or hum.Health > 0 then
                        local mag = (DexState.Root.Position - targetPart.Position).Magnitude
                        if mag < shortestDistance then
                            closestTarget = targetPart
                            shortestDistance = mag
                        end
                    end
                end
            end
        end
        return closestTarget
    end
    return nil
end

local function getClosestFullModelDex()
    if DexState.Root then
        local closestModel = nil
        local shortestDist = 1e999
        for _, descendant in ipairs(workspace:GetDescendants()) do
            if descendant:IsA("Model") and descendant ~= DexState.Char then
                local hum = descendant:FindFirstChildOfClass("Humanoid")
                local hrp = descendant:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and hrp then
                    local mag = (DexState.Root.Position - hrp.Position).Magnitude
                    if mag < shortestDist then
                        shortestDist = mag
                        closestModel = descendant
                    end
                end
            end
        end
        return closestModel
    end
    return nil
end

--// Dex Routines \\--
local function executeKyoto()
    if not (os.clock() - Dex.Kyoto.Last < Dex.Kyoto.Cd) then
        Dex.Kyoto.Last = os.clock()
        if DexState.Root then
            DexState.Root.CFrame = DexState.Root.CFrame + DexState.Root.CFrame.LookVector * Dex.Kyoto.Dist
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Two, false, game)
                task.wait(0.05)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Two, false, game)
            end)
        end
    end
end

local function executeLethalAim()
    if DexState.Hum and DexState.Root then
        DexState.Hum.AutoRotate = false
        local conn = DexState.Hum:GetPropertyChangedSignal("AutoRotate"):Connect(function()
            DexState.Hum.AutoRotate = false
        end)
        local targetModel = getClosestFullModelDex()

        if targetModel then
            local startTime = tick()
            local renderConn
            renderConn = RunService.RenderStepped:Connect(function()
                if Dex.Lethal.Enabled then
                    if tick() - startTime <= Dex.Lethal.Duration then
                        local hrp = targetModel:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local predictedPos = hrp.Position + hrp.AssemblyLinearVelocity * Dex.Lethal.Predict
                            DexState.Root.CFrame = CFrame.lookAt(DexState.Root.Position, Vector3.new(predictedPos.X, DexState.Root.Position.Y, predictedPos.Z))
                        end
                    else
                        renderConn:Disconnect()
                        conn:Disconnect()
                        DexState.Hum.AutoRotate = true
                    end
                else
                    renderConn:Disconnect()
                    conn:Disconnect()
                    DexState.Hum.AutoRotate = true
                end
            end)
        else
            DexState.Hum.AutoRotate = true
            conn:Disconnect()
        end
    end
end

local function executeMimicPlayback()
    if #Dex.Mimic.Buffer ~= 0 and not Dex.Mimic.Playing and DexState.Root then
        Dex.Mimic.Playing = true
        local startTime = tick()
        local idx = 1
        local playbackConn
        
        local oldStats = {
            WS = DexState.Hum.WalkSpeed,
            JP = DexState.Hum.JumpPower,
            PS = DexState.Hum.PlatformStand
        }
        DexState.Hum.WalkSpeed = 0
        DexState.Hum.JumpPower = 0
        DexState.Hum.PlatformStand = true

        playbackConn = RunService.Heartbeat:Connect(function()
            local elapsed = tick() - startTime
            while idx <= #Dex.Mimic.Buffer and elapsed >= Dex.Mimic.Buffer[idx].Time do
                if DexState.Root then
                    DexState.Root.CFrame = DexState.Root.CFrame * Dex.Mimic.Buffer[idx].Offset
                    DexState.Root.Velocity = Dex.Mimic.Buffer[idx].Velocity
                end
                idx = idx + 1
            end
            if idx > #Dex.Mimic.Buffer then
                playbackConn:Disconnect()
                DexState.Hum.WalkSpeed = oldStats.WS
                DexState.Hum.JumpPower = oldStats.JP
                DexState.Hum.PlatformStand = oldStats.PS
                Dex.Mimic.Playing = false
            end
        end)
    end
end

local function executeDownSupa(mode)
    if DexState.Char and DexState.Hum and DexState.Root then
        if mode ~= "Frog" or Dex.Supa.AimHead then
            local targetPart = getClosestModelDex(mode == "AimHead" or mode == "Frog")
            if targetPart then
                local oldStats = {
                    WS = DexState.Hum.WalkSpeed,
                    JP = DexState.Hum.JumpPower,
                    PS = DexState.Hum.PlatformStand,
                    AR = pcall(function() return DexState.Hum.AutoRotate end) and DexState.Hum.AutoRotate or false,
                }

                DexState.Hum.WalkSpeed = 0
                DexState.Hum.JumpPower = 0
                DexState.Hum.PlatformStand = true
                DexState.Hum.AutoRotate = false
                DexState.Root.Velocity = Vector3.zero
                DexState.Root.RotVelocity = Vector3.zero

                for _, desc in pairs(DexState.Char:GetDescendants()) do
                    if desc:IsA("BodyVelocity") or desc:IsA("BodyPosition") or desc:IsA("BodyGyro") or desc:IsA("VectorForce") or desc:IsA("AlignPosition") or desc:IsA("AlignOrientation") or desc:IsA("LinearVelocity") or desc:IsA("AngularVelocity") then
                        pcall(function() desc:Destroy() end)
                    end
                end

                local lockConn = RunService.Heartbeat:Connect(function()
                    if DexState.Root then
                        DexState.Root.Velocity = Vector3.zero
                        DexState.Root.RotVelocity = Vector3.zero
                    end
                    if DexState.Hum then
                        DexState.Hum.WalkSpeed = 0
                    end
                end)

                pcall(function()
                    if DexState.Char:FindFirstChild("Communicate") then
                        DexState.Char.Communicate:FireServer({Dash = Enum.KeyCode.W, Key = Enum.KeyCode.Q, Goal = "KeyPress"})
                    end
                end)
                pcall(function()
                    if DexState.Char:FindFirstChild("Communicate") then
                        DexState.Char.Communicate:FireServer({Goal = "delete bv", BV = nil})
                    end
                end)

                task.wait(0.2)
                pcall(function() DexState.Hum:ChangeState(Enum.HumanoidStateType.Physics) end)

                if DexState.Root then
                    DexState.Root.CFrame = DexState.Root.CFrame * CFrame.Angles(1.0471975511965976, 0, 0)
                end

                if not Dex.Supa.DashPattern or #Dex.Mimic.Buffer == 0 then
                    local dur = Dex.Supa.StickDur
                    local stTime = tick()
                    local stickConn = RunService.Heartbeat:Connect(function()
                        if dur > tick() - stTime and DexState.Root and targetPart then
                            pcall(function()
                                DexState.Root.CFrame = CFrame.new(targetPart.Position - targetPart.CFrame.LookVector * 0.3) * CFrame.Angles(1.0471975511965976, 0, 0)
                            end)
                        end
                    end)
                    task.wait(dur)
                    stickConn:Disconnect()
                else
                    local stTime = tick()
                    local pIdx = 1
                    local patternConn
                    patternConn = RunService.Heartbeat:Connect(function()
                        local elap = tick() - stTime
                        while pIdx <= #Dex.Mimic.Buffer and elap >= Dex.Mimic.Buffer[pIdx].Time do
                            if DexState.Root then
                                DexState.Root.CFrame = DexState.Root.CFrame * Dex.Mimic.Buffer[pIdx].Offset
                                DexState.Root.Velocity = Dex.Mimic.Buffer[pIdx].Velocity
                            end
                            pIdx = pIdx + 1
                        end
                        if pIdx > #Dex.Mimic.Buffer or not DexState.DownSupaActive then
                            patternConn:Disconnect()
                        end
                    end)
                    local st2 = tick()
                    while Dex.Supa.StickDur > tick() - st2 and DexState.DownSupaActive do
                        task.wait()
                    end
                    patternConn:Disconnect()
                end

                lockConn:Disconnect()

                if mode == "Frog" and Dex.Supa.AimHead then
                    task.wait(Dex.Supa.FrogDelay)
                    if targetPart and targetPart.Parent then
                        local finalPart = targetPart.Parent:FindFirstChild("HumanoidRootPart") or targetPart.Parent:FindFirstChild("Head") or targetPart
                        if finalPart and DexState.Root then
                            pcall(function()
                                DexState.Root.CFrame = CFrame.new(finalPart.Position + Vector3.new(0, 3, 0)) * CFrame.Angles(1.0471975511965976, 0, 0)
                            end)
                            task.wait(0.1)
                        end
                    end
                end

                pcall(function() DexState.Hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
                pcall(function()
                    DexState.Hum.WalkSpeed = oldStats.WS
                    DexState.Hum.JumpPower = oldStats.JP
                    DexState.Hum.PlatformStand = oldStats.PS
                    DexState.Hum.AutoRotate = oldStats.AR
                    DexState.Root.Velocity = Vector3.zero
                    DexState.Root.RotVelocity = Vector3.zero
                end)
            end
        end
    end
end

local function executeTwisted()
    task.wait(Dex.Twisted.Delay)
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
    task.wait(0.5)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
    task.wait(1.7)

    if Dex.Twisted.Stick then
        local targetPart = getClosestModelDex(false)
        if targetPart and DexState.Root then
            local st = tick()
            local twistConn
            twistConn = RunService.Heartbeat:Connect(function()
                if tick() - st <= 0.2 and DexState.Root and targetPart then
                    pcall(function()
                        local unit = Vector3.new(targetPart.Position.X - DexState.Root.Position.X, 0, targetPart.Position.Z - DexState.Root.Position.Z).Unit
                        DexState.Root.CFrame = CFrame.new(targetPart.Position - targetPart.CFrame.LookVector * 0.3, targetPart.Position) * CFrame.Angles(-1.5707963267948966, 0, 0)
                        Camera.CFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + unit)
                    end)
                else
                    twistConn:Disconnect()
                end
            end)
        end
    end
end

local function triggerDownSupaSafely(mode)
    if not DexState.DownSupaActive and not (tick() - DexState.DownSupaCooldown < 0.3) then
        DexState.DownSupaCooldown = tick()
        DexState.DownSupaActive = true
        task.spawn(function() executeDownSupa(mode) end)
        task.delay(0.3, function() DexState.DownSupaActive = false end)
    end
end

