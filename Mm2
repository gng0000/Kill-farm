            autoFarmConnection = nil
        end
        return
    end
    
    if not autoFarmConnection then
        autoFarmConnection = RunService.Heartbeat:Connect(function()
            -- Anti-disconnect
            if Config.AutoFarm.AntiDisconnect then
                if tick() - lastMovement > 120 then
                    -- Simulate movement
                    local humanoid = Player.Character:FindFirstChild("Humanoid")
                    if humanoid then
                        humanoid:Move(Vector3.new(math.random(-1, 1), 0, math.random(-1, 1)))
                        lastMovement = tick()
                    end
                end
            end
            
            -- Farm coins
