        ApplyMovement()
        
        -- Character check for movement
        if not Player.Character then
            Player.CharacterAdded:Wait()
        end
    end)
end)

-- // Anti-Crash & Nil Checks
local function SafeExecute(func, errorMessage)
    local success, err = pcall(func)
    if not success then
        warn("⚠️ " .. errorMessage .. ": " .. tostring(err))
    end
end

