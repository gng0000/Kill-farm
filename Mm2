local TeleportSection = MiscTab:MakeSection({
    Name = "Teleport"
})

MiscTab:MakeButton({
    Name = "Teleport to Nearest Gun",
    Callback = function()
        local gun, distance = GetNearestGun(100)
        if gun then
            local handle = gun:FindFirstChild("Handle") or gun:FindFirstChild("hitbox")
            if handle and Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
                Player.Character.HumanoidRootPart.CFrame = handle.CFrame + Vector3.new(0, 2, 0)
            end
        end
    end
})

MiscTab:MakeButton({
    Name = "Teleport to Nearest Player",
    Callback = function()
        local target, distance = GetNearestPlayer(100)
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
                Player.Character.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame + Vector3.new(0, 0, 5)
            end
        end
    end
})

