    MoveBox:CreateSlider({ Name = "WalkSpeed Override", Range = {16, 200}, CurrentValue = 16, Increment = 1, Callback = function(V) Features.Movement.WalkSpeed = V end })
    MoveBox:CreateToggle({ Name = "Anti-Slow (Bypass)", CurrentValue = false, Callback = function(V) Features.Movement.AntiSlow = V end })

    -- LAG FIX (Dex Hub Integration)
    local PerfBox = Tab:CreateGroupbox({ Name = "Performance (Dex)", Column = 1 }, "PerfBox_Index")
    PerfBox:CreateButton({
        Name = "Execute Lag Fix",
        Icon = NebulaIcons:GetIcon('wrench', 'Lucide'),
        Callback = function()
            pcall(function()
                if DexState.Root then
                    local part = Instance.new("Part")
                    part.Name = "DexHubSafetyFloor"
                    part.Size = Vector3.new(9000, 1, 9000)
                    part.Position = DexState.Root.Position - Vector3.new(0, 3.5, 0)
                    part.Anchored = true
                    part.Transparency = 1
                    part.Material = Enum.Material.SmoothPlastic
                    part.Parent = workspace
                end
            end)
            for _, desc in pairs(workspace:GetDescendants()) do
                if desc ~= workspace.Terrain and desc ~= Camera and not desc:IsA("Camera") then
                    local isCharPart = false
                    local p = desc
                    while p and p ~= workspace do
                        if p:IsA("Model") and p:FindFirstChildOfClass("Humanoid") and p:FindFirstChild("HumanoidRootPart") then
                            isCharPart = true
                            break
                        end
                        p = p.Parent
                    end
                    if not isCharPart and desc.Name ~= "DexHubSafetyFloor" then
                        if not desc:IsA("BasePart") and not desc:IsA("MeshPart") then
                            if not desc:IsA("Model") and not desc:IsA("Folder") and not desc:IsA("Workspace") then pcall(function() desc:Destroy() end) end
                        else
                            local lName = string.lower(desc.Name)
                            local s = desc.Size
                            if not string.find(lName, "floor") and not string.find(lName, "ground") and not string.find(lName, "wall") and (s.Y < 35 or s.Y > 65) then
                                pcall(function() desc:Destroy() end)
                            end
                        end
                    end
                end
            end
        end,
    }, "LagFixBtn_Index")

    PerfBox:CreateButton({
        Name = "Remove VFX",
        Icon = NebulaIcons:GetIcon('trash-2', 'Lucide'),
        Callback = function()
            for _, desc in pairs(workspace:GetDescendants()) do
                if desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Beam") or desc:IsA("Sparkles") or desc:IsA("Smoke") or desc:IsA("Fire") then
                    pcall(function() desc:Destroy() end)
                end
            end
        end,
    }, "RemoveVFXBtn_Index")
end

